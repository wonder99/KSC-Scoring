{
  "name": "the-701-club",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based 701 darts league scorer",
  "scripts": {
    "build": "node --check app.js && node --check server.js && node --check start-server.js && node --check db/connection.js",
    "start": "node server.js",
    "migrate": "node db/migrate.js",
    "backfill:scores": "node db/backfill.js",
    "backfill:rosters": "node db/backfill-team-list-rosters.js",
    "backfill:schedule": "node db/backfill-schedule.js",
    "backfill:baselines": "node db/import-workbook-baselines.js",
    "backfill:honourable": "node db/import-honourable-mentions.js",
    "backfill:finishes": "node db/import-high-finishes.js",
    "merge:keepers-duplicates": "node db/merge-keepers-player-duplicates.js",
    "backup": "node db/backup.js",
    "restore": "node db/restore.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "pg": "^8.16.3"
  }
}
